# Short DADA-2000 integration test. Run this before the full profile.
DATASET_KIND=DADA2K
DATA_ROOT=/data/DADA2000
OUTPUT_ROOT=outputs/videomae_b_t4_smoke
INIT_CHECKPOINT=weights/simpletad_ft-dota_dapt-vm1-b_auroc.pth

BATCH_SIZE=2
UPDATE_FREQ=8
NUM_WORKERS=2
NUM_SAMPLES_PER_EPOCH=128

FROZEN_EPOCHS=1
FULL_EPOCHS=1
FREEZE_BLOCKS=8
WARMUP_EPOCHS_FROZEN=0
WARMUP_EPOCHS_FULL=0

BASE_LR=5e-4
MIN_LR=1e-6
WEIGHT_DECAY=0.05
LAYER_DECAY=0.6
DROP_PATH=0.2
CLIP_GRAD=1.0
LOSS=crossentropy
SEED=42

NUM_FRAMES=16
VIEW_FPS=10
INPUT_SIZE=224
TRAIN_SAMPLING_RATE=1
VAL_SAMPLING_RATE=1
