# Recommended continuation run: DoTA-trained VideoMAE-B -> DADA-2000.
DATASET_KIND=DADA2K
DATA_ROOT=/data/DADA2000
OUTPUT_ROOT=outputs/videomae_b_t4_dada
INIT_CHECKPOINT=weights/simpletad_ft-dota_dapt-vm1-b_auroc.pth

# T4 16 GB profile. Effective batch = 2 * 8 * 1 GPU = 16.
BATCH_SIZE=2
UPDATE_FREQ=8
NUM_WORKERS=4
NUM_SAMPLES_PER_EPOCH=25000

# Two-stage adaptation: stabilize upper layers, then unfreeze the full backbone.
FROZEN_EPOCHS=2
FULL_EPOCHS=18
FREEZE_BLOCKS=8
WARMUP_EPOCHS_FROZEN=1
WARMUP_EPOCHS_FULL=3

# The upstream script linearly scales this reference LR by effective_batch/256.
BASE_LR=5e-4
MIN_LR=1e-6
WEIGHT_DECAY=0.05
LAYER_DECAY=0.6
DROP_PATH=0.2
CLIP_GRAD=1.0
LOSS=crossentropy
SEED=42

# Input must remain identical to deployment.
NUM_FRAMES=16
VIEW_FPS=10
INPUT_SIZE=224
TRAIN_SAMPLING_RATE=1
VAL_SAMPLING_RATE=1
